# Copia este ficheiro para .env.local e preenche com os dados do teu projeto Supabase
# (Supabase Dashboard > Project Settings > API)

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANONIMA_PUBLICA

# Nunca coloques a "service_role key" aqui nem em nenhum ficheiro do frontend.
# Apenas a "anon public key" deve ser usada no cliente.
