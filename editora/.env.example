# Copia para .env.local e preenche. Tudo o que começa por VITE_ vai para o
# bundle do browser — por isso aqui só entram valores PÚBLICOS.

# Supabase (Project Settings > API). A anon key é pública por desenho: o
# acesso aos dados é controlado pelas políticas RLS da base de dados.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL pública do site (usado em SEO/Open Graph e nos redirecionamentos do pagamento).
VITE_APP_URL=http://localhost:5173

# Modo demonstração: dados fictícios guardados só no browser, sem Supabase.
# Ativo automaticamente em `npm run dev` quando o Supabase não está configurado.
# NUNCA ativar em produção.
VITE_DEMO_MODE=false

# ---------------------------------------------------------------------
# SEGREDOS — NUNCA aqui nem em variáveis VITE_*.
# Definem-se só no servidor, em Supabase > Edge Functions > Secrets:
#   DATABASE_URL            (só para ferramentas de migração/CLI)
#   PAYMENT_API_KEY         (chave do provedor de pagamentos)
#   PAYMENT_API_URL         (endpoint de criação de checkout do provedor)
#   PAYMENT_WEBHOOK_SECRET  (segredo HMAC para validar webhooks)
#   APP_URL                 (igual a VITE_APP_URL, usado pelas funções)
# ---------------------------------------------------------------------
